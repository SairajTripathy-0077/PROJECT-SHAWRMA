{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fsoc-pat-simulator",
  "version": "0.1.0",
  "identifier": "com.fsoc.pat.simulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FSOC PAT Virtual Simulator",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tracker"
    ]
  }
}
